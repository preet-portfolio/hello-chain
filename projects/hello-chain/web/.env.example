# Copy to .env.local. NEXT_PUBLIC_* values are exposed to the browser.
NEXT_PUBLIC_CHAIN_ID=31337      # 31337 = local anvil, 84532 = Base Sepolia
NEXT_PUBLIC_RPC_URL=            # e.g. http://127.0.0.1:8545 locally; empty uses the chain's default public RPC
NEXT_PUBLIC_RP_ID=              # WebAuthn relying-party id (registrable domain, no scheme/port); empty uses window.location.hostname (localhost in dev). Changing it orphans existing passkeys.

# --- Relayer (server-only; never prefix with NEXT_PUBLIC_) ---
RELAYER_PRIVATE_KEY=            # 0x-prefixed 32-byte hex key of the funded gas-paying account. Keep it out of git; set it in the host's secret store.
RPC_URL=                        # Server-side RPC for the relayer (can hold a private API key); empty falls back to NEXT_PUBLIC_RPC_URL
UPSTASH_REDIS_REST_URL=         # Optional: Upstash Redis REST URL for shared rate limits; without both Upstash vars an in-memory, per-instance limiter is used
UPSTASH_REDIS_REST_TOKEN=       # Optional: Upstash Redis REST token
# On Vercel production (VERCEL=1, NODE_ENV=production) both Upstash vars are REQUIRED: without them the relay refuses (503).
RELAY_GLOBAL_DAILY_LIMIT=       # Optional: max relayed entries per day across all visitors (spend ceiling); empty = 200
RELAY_MIN_BALANCE_WEI=          # Optional: relay refuses (503) while the relayer balance is below this many wei; empty = 2000000000000000 (0.002 ETH)
# Client IP for rate limits when NOT on Vercel (VERCEL=1 is detected automatically and needs nothing here).
# Set to exactly one header your own reverse proxy OVERWRITES on every request. Only that header is read; there is no fallback.
#   x-real-ip        proxy replaces any client-sent X-Real-IP with the peer address (nginx: proxy_set_header X-Real-IP $remote_addr)
#   x-forwarded-for  proxy appends the peer address; the LAST hop is used (nginx: $proxy_add_x_forwarded_for)
# A header the proxy merely passes through is client-controlled: choosing it lets anyone spoof their IP and bypass limits.
# Empty or any other value = untrusted: production refuses relay requests (503); development uses one "dev-local" bucket.
# If the chosen header is missing on a request, that request gets 503.
TRUSTED_PROXY_HEADER=

# --- "How it works" links (optional; filled in after deploy). Each link is hidden while its value is empty. ---
NEXT_PUBLIC_CONTRACT_EXPLORER_URL=  # Explorer page of the verified contract, e.g. https://sepolia.basescan.org/address/0x…#code
NEXT_PUBLIC_SOURCE_URL=             # Public source repository, e.g. https://github.com/<you>/<repo>
NEXT_PUBLIC_SITE_URL=               # Optional canonical site URL for Open Graph links; empty uses Vercel's production URL, then localhost
