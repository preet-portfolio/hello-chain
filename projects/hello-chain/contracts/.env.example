# Environment for forge scripts (script/*.s.sol). Copy to .env and fill in; never commit real values.
# Forge loads .env automatically, and vm.envOr() fails on a variable that is SET but EMPTY, so optional
# variables stay commented out until you give them a value.

# Deploy.s.sol
# OWNER=0x...       # contract owner; defaults to the broadcaster when unset
# COOLDOWN=86400    # seconds between signs per visitor, 3600..86400 (default 86400)

# Hide.s.sol (usually passed inline: ENTRY_ID=3 HIDDEN=true forge script ...)
# ENTRY_ID=         # entry id to moderate (required by Hide.s.sol)
# HIDDEN=true       # true hides, false unhides (default true)

# SeedLocal.s.sol (local anvil only). Defaults to anvil's PUBLIC dev keys #1..#3; leave unset locally.
# SEED_PK_1=
# SEED_PK_2=
# SEED_PK_3=

# Base Sepolia deploy. These are read by your SHELL (e.g. --rpc-url "$BASE_SEPOLIA_RPC_URL"), not by the
# scripts, so load them first: set -a; source .env; set +a
# Prefer a Foundry keystore (cast wallet import deployer --interactive, then --account deployer) over a raw key.
BASE_SEPOLIA_RPC_URL=     # JSON-RPC endpoint for Base Sepolia
DEPLOYER_PRIVATE_KEY=     # only if not using a keystore: throwaway testnet key, never one that holds real funds
